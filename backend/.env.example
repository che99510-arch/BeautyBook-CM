# ── Django Core ───────────────────────────────────────────────────────────
SECRET_KEY=your-secret-key-here-generate-a-random-50-char-string
DEBUG=False

# ── Allowed Hosts ─────────────────────────────────────────────────────────
# Add your Railway domain and any custom domain
ALLOWED_HOSTS=localhost,127.0.0.1,your-app.up.railway.app

# ── Database (Railway PostgreSQL fills these automatically) ───────────────
DB_ENGINE=django.db.backends.postgresql
DB_NAME=railway
DB_USER=postgres
DB_PASSWORD=your-db-password
DB_HOST=your-db-host.railway.internal
DB_PORT=5432

# ── CORS (add your Vercel frontend URLs) ──────────────────────────────────
# Comma-separated list handled by settings.py
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8080,https://your-frontend.vercel.app

# ── Cloudinary (media file storage for production) ────────────────────────
# Get this from https://cloudinary.com → Dashboard → API Environment Variable
# Format: cloudinary://API_KEY:API_SECRET@CLOUD_NAME
CLOUDINARY_URL=cloudinary://your_api_key:your_api_secret@your_cloud_name
